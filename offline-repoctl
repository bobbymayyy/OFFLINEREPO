#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CFG="${CFG:-$HERE/config.yml}"

log() {
  mkdir -p "$HERE/logs"
  printf '%s\n' "$*" | tee -a "$HERE/logs/offline-repoctl.log" >/dev/null
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing dependency: $1" >&2
    exit 1
  }
}

as_root() {
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    "$@"
  else
    need sudo
    sudo "$@"
  fi
}

detect_engine() {
  if command -v docker >/dev/null 2>&1; then echo docker; return; fi
  if command -v podman >/dev/null 2>&1; then echo podman; return; fi
  echo none
}

bootstrap() {
  if command -v apt-get >/dev/null 2>&1; then
    as_root apt-get update
    as_root apt-get install -y podman rsync dialog python3 python3-yaml gnupg
  elif command -v dnf >/dev/null 2>&1; then
    as_root dnf -y install podman rsync dialog python3 python3-pyyaml gnupg2 dnf-plugins-core
  else
    echo "Unsupported host: need apt-get or dnf for bootstrap." >&2
    return 1
  fi
  echo "Bootstrap complete. Existing Docker installations are also supported."
}

require_image() {
  local engine="$1" image="$2"
  if ! "$engine" image inspect "$image" >/dev/null 2>&1; then
    echo "Required image not found in $engine image store: $image" >&2
    echo "Run: $0 build-images" >&2
    return 1
  fi
}

py_get() {
  python3 - "$1" "$CFG" <<'PYCFG'
import sys, yaml
path = sys.argv[1].split('.')
cfg = yaml.safe_load(open(sys.argv[2], 'r', encoding='utf-8')) or {}
cur = cfg
for part in path:
    cur = cur.get(part) if isinstance(cur, dict) else None
    if cur is None:
        break
print('' if cur is None else cur)
PYCFG
}

py_get_path() {
  python3 - "$1" "$CFG" <<'PYCFG'
import os, sys, yaml
path = sys.argv[1].split('.')
cfg = yaml.safe_load(open(sys.argv[2], 'r', encoding='utf-8')) or {}
cur = cfg
for part in path:
    cur = cur.get(part) if isinstance(cur, dict) else None
    if cur is None:
        break
if cur is None or not str(cur).strip():
    print('')
else:
    print(os.path.abspath(os.path.expanduser(str(cur))))
PYCFG
}

py_bool_any_enabled() {
  python3 - "$1" "$CFG" <<'PYCFG'
import sys, yaml
key = sys.argv[1]
cfg = yaml.safe_load(open(sys.argv[2], 'r', encoding='utf-8')) or {}
items = cfg.get(key, []) or []
print('yes' if any(item.get('enabled', False) for item in items) else 'no')
PYCFG
}

py_enabled_rpm_specs() {
  python3 - "$CFG" <<'PYCFG'
import sys, yaml
cfg = yaml.safe_load(open(sys.argv[1], 'r', encoding='utf-8')) or {}
for item in cfg.get('rpm', []) or []:
    if not item.get('enabled', False):
        continue
    name = str(item.get('name', '')).strip()
    runner = str(item.get('runner', name)).strip().lower()
    if name:
        print(f'{name}\t{runner}')
PYCFG
}

py_rpm_repoids() {
  python3 - "$1" "$CFG" <<'PYCFG'
import sys, yaml
name = sys.argv[1]
cfg = yaml.safe_load(open(sys.argv[2], 'r', encoding='utf-8')) or {}
for item in cfg.get('rpm', []) or []:
    if str(item.get('name', '')).lower() != name.lower():
        continue
    for repo in item.get('repos', []) or []:
        if repo.get('enabled', True):
            print(repo['repoid'])
PYCFG
}

validate_repo_root() {
  local repo_root="$1"
  [[ -n "$repo_root" ]] || { echo "paths.repo_root is empty in config.yml" >&2; return 1; }
  if [[ "$repo_root" == *"<user>"* ]]; then
    echo "Edit paths.repo_root in config.yml; it still contains the <user> placeholder." >&2
    return 1
  fi
}

build_images() {
  local engine
  engine="$(detect_engine)"
  [[ "$engine" != none ]] || {
    echo "Need Docker or Podman. Run: $0 bootstrap" >&2
    return 1
  }

  local debian_image fedora_image rocky_image
  debian_image="$(py_get containers.debian_image)"
  fedora_image="$(py_get containers.fedora_image)"
  rocky_image="$(py_get containers.rocky_image)"

  "$engine" build -t "$debian_image" -f "$HERE/containers/Dockerfile.debian" "$HERE/containers"
  "$engine" build -t "$fedora_image" -f "$HERE/containers/Dockerfile.fedora" "$HERE/containers"
  "$engine" build -t "$rocky_image" -f "$HERE/containers/Dockerfile.rocky" "$HERE/containers"
}

container_run() {
  local image="$1"; shift
  local engine
  engine="$(detect_engine)"
  [[ "$engine" != none ]] || { echo "Need Docker or Podman installed." >&2; return 1; }
  require_image "$engine" "$image"

  local repo_root
  repo_root="$(py_get_path paths.repo_root)"
  validate_repo_root "$repo_root"
  mkdir -p "$repo_root"/{apt,rpm,apk,logs,keys}

  local repo_mount="$repo_root:/repo"
  local ro_suffix=":ro"
  if [[ "$engine" == podman ]] && command -v getenforce >/dev/null 2>&1; then
    if [[ "$(getenforce 2>/dev/null || true)" != Disabled ]]; then
      repo_mount="$repo_root:/repo:Z"
      ro_suffix=":ro,Z"
    fi
  fi

  local -a extra_args=()
  if [[ "${WITH_APT_SIGNING:-0}" == 1 ]]; then
    local signing_key passphrase_file
    signing_key="$(py_get_path global.aptly_private_key_file)"
    [[ -f "$signing_key" ]] || {
      echo "APT signing key not found on sync host: $signing_key" >&2
      echo "See README.md -> Repository signing key." >&2
      return 1
    }
    extra_args+=(
      -e OFFLINEREPO_SIGNING_KEY_FILE=/run/secrets/offline-repo-signing-private.asc
      -v "$signing_key:/run/secrets/offline-repo-signing-private.asc$ro_suffix"
    )

    passphrase_file="$(py_get_path global.aptly_gpg_passphrase_file)"
    if [[ -n "$passphrase_file" ]]; then
      [[ -f "$passphrase_file" ]] || {
        echo "Configured GPG passphrase file not found: $passphrase_file" >&2
        return 1
      }
      extra_args+=(
        -e OFFLINEREPO_SIGNING_PASSPHRASE_FILE=/run/secrets/offline-repo-signing-passphrase
        -v "$passphrase_file:/run/secrets/offline-repo-signing-passphrase$ro_suffix"
      )
    fi
  fi

  "$engine" run --rm \
    -e CFG=/work/config.yml \
    -e REPO_ROOT=/repo \
    -e OFFLINEREPO_RUN_ID="${OFFLINEREPO_RUN_ID:-}" \
    -v "$CFG:/work/config.yml:ro" \
    -v "$HERE/lib:/work/lib:ro" \
    -v "$repo_mount" \
    "${extra_args[@]}" \
    -w /work \
    "$image" "$@"
}

check_apt_publish_fs() {
  local method repo_root test_a test_b test_dir
  method="$(py_get global.aptly_publish_link_method)"
  [[ -n "$method" ]] || method=hardlink
  [[ "$method" == hardlink ]] || return 0

  repo_root="$(py_get_path paths.repo_root)"
  validate_repo_root "$repo_root"
  test_dir="$repo_root/apt/.offlinerepo-hardlink-test.$$"
  mkdir -p "$test_dir"
  test_a="$test_dir/source"
  test_b="$test_dir/link"
  : > "$test_a"
  if ! ln "$test_a" "$test_b" 2>/dev/null; then
    rm -rf "$test_dir"
    echo "The repository filesystem does not support hardlinks." >&2
    echo "Set global.aptly_publish_link_method: copy (uses more space) or use a hardlink-capable filesystem." >&2
    return 1
  fi
  rm -rf "$test_dir"
}

sync_apt() {
  local image
  check_apt_publish_fs
  image="$(py_get containers.debian_image)"
  [[ -n "$image" ]] || { echo "containers.debian_image missing" >&2; return 1; }
  log "[INFO] starting APT sync with image: $image"
  if WITH_APT_SIGNING=1 container_run "$image" /work/lib/sync_apt.py |& tee -a "$HERE/logs/sync_apt.log"; then
    log "[INFO] completed APT sync successfully"
  else
    log "[ERROR] APT sync failed"
    return 1
  fi
}

prepare_rhel() {
  need dnf
  need subscription-manager
  if ! subscription-manager identity >/dev/null 2>&1; then
    echo "RHEL mirroring requires this host to be registered and entitled." >&2
    echo "Register the RHEL host, then rerun OFFLINEREPO. Satellite is not required." >&2
    return 1
  fi

  local repoid
  while IFS= read -r repoid; do
    [[ -n "$repoid" ]] || continue
    if ! dnf -q repolist --enabled 2>/dev/null | grep -Fq "$repoid"; then
      echo "+ enabling RHEL repository: $repoid"
      as_root subscription-manager repos --enable="$repoid" >/dev/null
    fi
  done < <(py_rpm_repoids rhel)
}

check_rhel_entitlement() {
  local warning=""
  if ! command -v dnf >/dev/null 2>&1 || ! command -v subscription-manager >/dev/null 2>&1; then
    warning="[WARN] RPM rhel: enabled in config.yml, but this is not a usable registered RHEL host (dnf and subscription-manager are required). Skipping RHEL preflight; use a registered, entitled RHEL host for these repositories."
  elif ! subscription-manager identity >/dev/null 2>&1; then
    warning="[WARN] RPM rhel: enabled in config.yml, but this host is not registered/entitled with Red Hat. Skipping RHEL preflight; register the host and rerun. Satellite is not required."
  fi

  if [[ -n "$warning" ]]; then
    printf '%s\n' "$warning" | tee -a "$HERE/logs/preflight.log" >&2
    return 1
  fi
  return 0
}

sync_rpm() {
  local distro runner rc=0
  while IFS=$'\t' read -r distro runner; do
    [[ -n "$distro" ]] || continue

    if [[ "$runner" == host ]]; then
      if [[ "$distro" == rhel ]]; then
        prepare_rhel || { rc=1; continue; }
      fi
      local repo_root
      repo_root="$(py_get_path paths.repo_root)"
      validate_repo_root "$repo_root"
      mkdir -p "$repo_root/rpm"
      log "[INFO] starting RPM sync for $distro on host"
      if CFG="$CFG" REPO_ROOT="$repo_root" ONLY_RPM_NAME="$distro" \
        OFFLINEREPO_RUN_ID="${OFFLINEREPO_RUN_ID:-}" \
        PYTHONPATH="$HERE/lib${PYTHONPATH:+:$PYTHONPATH}" \
        python3 "$HERE/lib/sync_rpm.py" |& tee -a "$HERE/logs/sync_rpm.log"; then
        log "[INFO] completed RPM sync for $distro successfully"
      else
        log "[ERROR] RPM sync failed for $distro"
        rc=1
      fi
      continue
    fi

    local image=""
    case "$runner" in
      fedora) image="$(py_get containers.fedora_image)" ;;
      rocky) image="$(py_get containers.rocky_image)" ;;
      *)
        echo "Unknown RPM runner '$runner' for '$distro'. Use fedora, rocky, or host." >&2
        rc=1
        continue
        ;;
    esac

    log "[INFO] starting RPM sync for $distro with image: $image"
    if container_run "$image" env ONLY_RPM_NAME="$distro" /work/lib/sync_rpm.py |& tee -a "$HERE/logs/sync_rpm.log"; then
      log "[INFO] completed RPM sync for $distro successfully"
    else
      log "[ERROR] RPM sync failed for $distro"
      rc=1
    fi
  done < <(py_enabled_rpm_specs)
  return "$rc"
}

sync_apk() {
  local image
  image="$(py_get containers.fedora_image)"
  [[ -n "$image" ]] || { echo "containers.fedora_image missing" >&2; return 1; }
  log "[INFO] starting APK sync with image: $image"
  if container_run "$image" /work/lib/sync_apk.sh |& tee -a "$HERE/logs/sync_apk.log"; then
    log "[INFO] completed APK sync successfully"
  else
    log "[ERROR] APK sync failed"
    return 1
  fi
}

preflight_apt() {
  local image
  image="$(py_get containers.debian_image)"
  [[ -n "$image" ]] || { echo "containers.debian_image missing" >&2; return 1; }
  log "[INFO] starting APT package reachability preflight"
  if container_run "$image" bash -lc '
    PREFLIGHT_FAMILY=apt python3 /work/lib/preflight.py
    rc=$?
    python3 /work/lib/preflight_capacity.py collect apt || true
    exit "$rc"
  ' |& tee -a "$HERE/logs/preflight.log"; then
    log "[INFO] APT preflight completed successfully"
  else
    log "[ERROR] APT preflight failed"
    return 1
  fi
}

preflight_rpm() {
  local distro runner rc=0
  while IFS=$'\t' read -r distro runner; do
    [[ -n "$distro" ]] || continue

    if [[ "$runner" == host ]]; then
      if [[ "$distro" == rhel ]]; then
        check_rhel_entitlement || continue
      fi
      log "[INFO] starting RPM package reachability preflight for $distro on host"
      if CFG="$CFG" ONLY_RPM_NAME="$distro" PREFLIGHT_FAMILY=rpm \
        python3 "$HERE/lib/preflight.py" |& tee -a "$HERE/logs/preflight.log"; then
        log "[INFO] RPM preflight completed successfully for $distro"
      else
        log "[ERROR] RPM preflight failed for $distro"
        rc=1
      fi
      CFG="$CFG" ONLY_RPM_NAME="$distro" \
        python3 "$HERE/lib/preflight_capacity.py" collect rpm |& tee -a "$HERE/logs/preflight.log" || true
      continue
    fi

    local image=""
    case "$runner" in
      fedora) image="$(py_get containers.fedora_image)" ;;
      rocky) image="$(py_get containers.rocky_image)" ;;
      *)
        echo "Unknown RPM runner '$runner' for '$distro'. Use fedora, rocky, or host." >&2
        rc=1
        continue
        ;;
    esac

    log "[INFO] starting RPM package reachability preflight for $distro"
    if container_run "$image" env ONLY_RPM_NAME="$distro" bash -lc '
      PREFLIGHT_FAMILY=rpm python3 /work/lib/preflight.py
      rc=$?
      python3 /work/lib/preflight_capacity.py collect rpm || true
      exit "$rc"
    ' |& tee -a "$HERE/logs/preflight.log"; then
      log "[INFO] RPM preflight completed successfully for $distro"
    else
      log "[ERROR] RPM preflight failed for $distro"
      rc=1
    fi
  done < <(py_enabled_rpm_specs)
  return "$rc"
}

preflight_apk() {
  local image
  image="$(py_get containers.fedora_image)"
  [[ -n "$image" ]] || { echo "containers.fedora_image missing" >&2; return 1; }
  log "[INFO] starting Alpine package reachability preflight"
  if container_run "$image" bash -lc '
    PREFLIGHT_FAMILY=apk python3 /work/lib/preflight.py
    rc=$?
    python3 /work/lib/preflight_capacity.py collect apk || true
    exit "$rc"
  ' |& tee -a "$HERE/logs/preflight.log"; then
    log "[INFO] Alpine preflight completed successfully"
  else
    log "[ERROR] Alpine preflight failed"
    return 1
  fi
}

install_portable_helpers() {
  local repo_root
  repo_root="$(py_get_path paths.repo_root)"
  validate_repo_root "$repo_root"
  mkdir -p "$repo_root"

  [[ -f "$HERE/serve-offlinerepo.py" ]] || {
    echo "Portable server source missing: $HERE/serve-offlinerepo.py" >&2
    return 1
  }
  [[ -f "$HERE/lib/offload-offlinerepo.py" ]] || {
    echo "Portable offload source missing: $HERE/lib/offload-offlinerepo.py" >&2
    return 1
  }

  cp "$HERE/serve-offlinerepo.py" "$repo_root/serve-offlinerepo.py"
  cp "$HERE/lib/offload-offlinerepo.py" "$repo_root/offload-offlinerepo.py"
  chmod 0755 "$repo_root/serve-offlinerepo.py" "$repo_root/offload-offlinerepo.py" 2>/dev/null || true
  python3 "$HERE/lib/unit_state.py" index "$repo_root"
  log "[INFO] installed portable HTTP/offload helpers in $repo_root"
}

serve_repo() {
  local repo_root
  need python3
  repo_root="$(py_get_path paths.repo_root)"
  validate_repo_root "$repo_root"
  [[ -d "$repo_root" ]] || {
    echo "Repository root does not exist: $repo_root" >&2
    return 1
  }
  exec python3 "$HERE/serve-offlinerepo.py" --root "$repo_root" "$@"
}

show_state() {
  local repo_root
  repo_root="$(py_get_path paths.repo_root)"
  validate_repo_root "$repo_root"
  python3 "$HERE/lib/unit_state.py" show "$repo_root"
}

sync_permanent() {
  local repo_root permanent
  repo_root="$(py_get_path paths.repo_root)"
  permanent="$(py_get_path paths.permanent_root)"
  [[ -n "$permanent" ]] || return 0
  validate_repo_root "$repo_root"
  mkdir -p "$permanent"
  python3 "$HERE/lib/offload-offlinerepo.py" --source "$repo_root" "$permanent" \
    |& tee -a "$HERE/logs/sync_permanent.log"
}

export_snippets() {
  python3 - "$CFG" <<'PYCFG'
import sys, yaml
cfg = yaml.safe_load(open(sys.argv[1], 'r', encoding='utf-8')) or {}
base = str((cfg.get('paths', {}) or {}).get('publish_url_base', '')).rstrip('/')
print(f'# OFFLINEREPO base URL: {base}')
print('#')
print('# APT: install OFFLINEREPO public signing key once on each client:')
print(f'#   wget -qO /tmp/offline-repo.gpg {base}/keys/offline-repo-signing-public.gpg')
print('#   sudo install -m 0644 /tmp/offline-repo.gpg /usr/share/keyrings/offline-repo.gpg')
for distro in cfg.get('apt', []) or []:
    if not distro.get('enabled', False):
        continue
    name = distro.get('name')
    for mirror in distro.get('mirrors', []) or []:
        if not mirror.get('enabled', True):
            continue
        mn = mirror['mirror_name']
        source_dist = str(mirror['distribution'])
        dist = str(mirror.get('publish_distribution', mn if source_dist in ('./', '/') else source_dist))
        comps = mirror.get('components', []) or [mirror.get('publish_component', 'main')]
        comps_s = ' '.join(str(x) for x in comps)
        print(f'deb [signed-by=/usr/share/keyrings/offline-repo.gpg] {base}/apt/{name}/{mn} {dist} {comps_s}')

print('\n# RPM/DNF/YUM repository examples. Package signature checking stays enabled.')
for distro in cfg.get('rpm', []) or []:
    if not distro.get('enabled', False):
        continue
    name = distro.get('name')
    rel = distro.get('releasever', '')
    for repo in distro.get('repos', []) or []:
        if not repo.get('enabled', True):
            continue
        repoid = repo['repoid']
        section = f'offline-{name}-{repoid}'.replace('_', '-').replace('.', '-')
        print(f'\n[{section}]')
        print(f'name=OFFLINEREPO {name} {repoid}')
        print(f'baseurl={base}/rpm/{name}/{rel}/{repoid}/')
        print('enabled=1')
        print('gpgcheck=1')
        print('repo_gpgcheck=0')
        if repo.get('gpgkey_url'):
            print(f'gpgkey={base}/keys/rpm/{name}-{repoid}.pub')

print('\n# Alpine /etc/apk/repositories entries:')
for distro in cfg.get('apk', []) or []:
    if not distro.get('enabled', False):
        continue
    name = distro.get('name')
    for mirror in distro.get('mirrors', []) or []:
        if mirror.get('enabled', True):
            print(f'{base}/apk/{name}/{mirror["mirror_name"]}')

print('\n# Note: CUDA RPM clients also need NVIDIA\'s public RPM signing key installed locally.')
PYCFG
}

validate_config() {
  python3 - "$CFG" <<'PYCFG'
import sys, yaml
cfg = yaml.safe_load(open(sys.argv[1], 'r', encoding='utf-8')) or {}
errors = []
root = str((cfg.get('paths', {}) or {}).get('repo_root', ''))
if not root or '<user>' in root:
    errors.append('paths.repo_root is unset or still contains <user>')

for family in ('apt', 'rpm', 'apk'):
    names = []
    for item in cfg.get(family, []) or []:
        name = str(item.get('name', '')).strip()
        if not name:
            errors.append(f'{family}: entry missing name')
        elif name in names:
            errors.append(f'{family}: duplicate name {name}')
        names.append(name)

if any(d.get('enabled', False) for d in cfg.get('apt', []) or []):
    fp = str((cfg.get('global', {}) or {}).get('aptly_gpg_key', ''))
    if not fp or fp.startswith('YOUR_'):
        errors.append('APT is enabled but global.aptly_gpg_key is not configured')
    link_method = str((cfg.get('global', {}) or {}).get('aptly_publish_link_method', 'hardlink'))
    if link_method not in ('hardlink', 'copy'):
        errors.append('global.aptly_publish_link_method must be hardlink or copy')

    for distro in cfg.get('apt', []) or []:
        if not distro.get('enabled', False):
            continue
        enabled_mirrors = [m for m in distro.get('mirrors', []) or [] if m.get('enabled', True)]
        if not enabled_mirrors:
            errors.append(f"apt:{distro.get('name', '<unnamed>')} is enabled but has no enabled mirrors")

for distro in cfg.get('rpm', []) or []:
    if distro.get('enabled', False) and not any(r.get('enabled', True) for r in distro.get('repos', []) or []):
        errors.append(f"rpm:{distro.get('name', '<unnamed>')} is enabled but has no enabled repos")

for distro in cfg.get('apk', []) or []:
    if distro.get('enabled', False) and not any(m.get('enabled', True) for m in distro.get('mirrors', []) or []):
        errors.append(f"apk:{distro.get('name', '<unnamed>')} is enabled but has no enabled mirrors")

global_cfg = cfg.get('global', {}) or {}
for key in ('preflight_concurrency', 'preflight_timeout_sec', 'preflight_metadata_timeout_sec'):
    value = global_cfg.get(key)
    if value is None:
        continue
    try:
        parsed = int(value)
    except (TypeError, ValueError):
        errors.append(f'global.{key} must be a positive integer')
        continue
    if parsed < 1:
        errors.append(f'global.{key} must be a positive integer')

if errors:
    for error in errors:
        print(f'ERROR: {error}', file=sys.stderr)
    raise SystemExit(1)
print('Configuration syntax and enabled repository selections look good.')
PYCFG
}

preflight_all() {
  mkdir -p "$HERE/logs"
  : > "$HERE/logs/preflight.log"
  validate_config
  log "[INFO] preflight started"

  local rc=0
  if [[ "$(py_bool_any_enabled apt)" == yes ]]; then
    preflight_apt || rc=1
  fi
  if [[ "$(py_bool_any_enabled rpm)" == yes ]]; then
    preflight_rpm || rc=1
  fi
  if [[ "$(py_bool_any_enabled apk)" == yes ]]; then
    preflight_apk || rc=1
  fi

  local repo_root summary_output
  repo_root="$(py_get_path paths.repo_root)"
  if summary_output="$(python3 "$HERE/lib/preflight_capacity.py" summarize \
      --config "$CFG" \
      --log "$HERE/logs/preflight.log" \
      --repo-root "$repo_root" 2>&1)"; then
    printf '%s\n' "$summary_output" | tee -a "$HERE/logs/preflight.log"
  else
    printf '%s\n' "[WARN] CAPACITY: unable to build the preflight grand summary: $summary_output" \
      | tee -a "$HERE/logs/preflight.log" >&2
  fi

  if [[ "$rc" -eq 0 ]]; then
    if grep -q '^\[WARN\]' "$HERE/logs/preflight.log" 2>/dev/null; then
      log "[WARN] preflight finished successfully with skipped/warning conditions"
      echo "Preflight complete with warnings: every enumerated package payload was reachable, but one or more enabled repositories were skipped or partially checked. See: $HERE/logs/preflight.log"
    else
      log "[INFO] preflight finished successfully"
      echo "Preflight complete: every enumerated package payload was reachable."
    fi
  else
    log "[ERROR] preflight finished with failures"
    echo "Preflight failed: one or more repositories or package payloads were unreachable." >&2
    echo "See: $HERE/logs/preflight.log" >&2
  fi
  return "$rc"
}

show_config() {
  if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
    less "$CFG"
  else
    cat "$CFG"
  fi
}

edit_config() {
  "${EDITOR:-nano}" "$CFG"
}

sync_all() {
  mkdir -p "$HERE/logs"
  validate_config
  export OFFLINEREPO_RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  log "[INFO] sync_all started run=$OFFLINEREPO_RUN_ID"

  local rc=0
  if [[ "$(py_bool_any_enabled apt)" == yes ]]; then
    sync_apt || rc=1
  fi
  if [[ "$(py_bool_any_enabled rpm)" == yes ]]; then
    sync_rpm || rc=1
  fi
  if [[ "$(py_bool_any_enabled apk)" == yes ]]; then
    sync_apk || rc=1
  fi

  install_portable_helpers || rc=1
  if [[ "$rc" -eq 0 ]]; then
    sync_permanent || rc=1
  else
    log "[WARN] skipping paths.permanent_root transfer because repository sync had failures"
  fi

  if [[ "$rc" -eq 0 ]]; then
    log "[INFO] sync_all finished successfully"
  else
    log "[ERROR] sync_all finished with failures"
  fi
  return "$rc"
}

tui() {
  need dialog
  while true; do
    local choice
    choice=$(dialog --clear --stdout --title "offline-repoctl" \
      --menu "Portable multi-distro repository mirror" 0 0 0 \
      1 "View current configuration" \
      2 "Edit configuration" \
      3 "Validate configuration" \
      4 "Preflight enabled repositories (dry run)" \
      5 "Sync enabled repositories" \
      6 "View synchronized repository units" \
      7 "View controller log" \
      8 "View preflight log" \
      9 "Export client setup snippets" \
      10 "Exit") || true

    case "${choice:-10}" in
      1) dialog --title "config.yml" --textbox "$CFG" 0 0 ;;
      2) edit_config ;;
      3)
        if output="$(validate_config 2>&1)"; then
          dialog --msgbox "$output" 8 70
        else
          dialog --msgbox "$output" 12 80
        fi
        ;;
      4)
        dialog --infobox "Preflight running; package reachability is being tested..." 6 72
        if preflight_all; then
          dialog --msgbox "Preflight succeeded. Every enumerated package payload was reachable." 8 72
        else
          dialog --msgbox "Preflight failed. See logs/preflight.log for package-level failures." 8 72
        fi
        ;;
      5)
        dialog --infobox "Syncing repositories enabled in config.yml..." 5 70
        if sync_all; then
          dialog --msgbox "Sync complete." 6 40
        else
          dialog --msgbox "Sync failed. Check logs." 7 60
        fi
        ;;
      6) dialog --title "repository units" --msgbox "$(show_state)" 0 0 ;;
      7) dialog --title "logs/offline-repoctl.log" --textbox "$HERE/logs/offline-repoctl.log" 0 0 ;;
      8) dialog --title "logs/preflight.log" --textbox "$HERE/logs/preflight.log" 0 0 ;;
      9) dialog --title "client snippets" --msgbox "$(export_snippets)" 0 0 ;;
      10) clear; exit 0 ;;
    esac
  done
}

case "${1:-}" in
  bootstrap) bootstrap ;;
  build-images) build_images ;;
  validate) validate_config ;;
  preflight) preflight_all ;;
  sync) sync_all ;;
  state) show_state ;;
  serve)
    shift
    serve_repo "$@"
    ;;
  install-helpers|install-server) install_portable_helpers ;;
  tui) tui ;;
  show-config) show_config ;;
  edit-config) edit_config ;;
  export-snippets) export_snippets ;;
  *)
    cat <<EOF
Usage:
  $0 bootstrap          # install host prerequisites once
  $0 build-images       # build the configured APT/RPM helper images
  $0 validate           # validate config.yml without network/package probing
  $0 preflight          # enumerate/probe repositories enabled in config.yml
  $0 sync               # sync repositories enabled in config.yml
  $0 state              # list independently synchronized repository units
  $0 serve [options]    # serve paths.repo_root over HTTP (default 0.0.0.0:8080)
  $0 install-helpers    # refresh portable HTTP/offload helpers in paths.repo_root
  $0 tui
  $0 show-config
  $0 edit-config
  $0 export-snippets

Typical first run:
  1. $0 bootstrap
  2. edit config.yml (repo_root, signing fingerprint, enabled suites/repos/components)
  3. create the APT publishing key as documented in README.md
  4. $0 build-images
  5. $0 validate
  6. $0 preflight
  7. $0 sync
  8. $0 state
EOF
    ;;
esac
