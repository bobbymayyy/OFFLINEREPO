FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg gpgv \
    rsync bash \
    coreutils findutils \
    aptly \
    python3 python3-yaml \
    debian-archive-keyring \
    ubuntu-keyring \
  && rm -rf /var/lib/apt/lists/*

# Kali archive keyring, published by Kali.
RUN curl -fsSL https://archive.kali.org/archive-keyring.gpg \
    -o /usr/share/keyrings/kali-archive-keyring.gpg \
  && test -s /usr/share/keyrings/kali-archive-keyring.gpg

# PVE 9 / Debian 13 (Trixie) release key. Fail closed instead of silently
# falling back to a key for a different Proxmox/Debian generation.
RUN curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-trixie.gpg \
    -o /usr/share/keyrings/proxmox-release.gpg \
  && test -s /usr/share/keyrings/proxmox-release.gpg

# NVIDIA rotates repository keys per platform generation. OFFLINEREPO's APT
# helper can mirror Debian 12/13 and Ubuntu 24.04/26.04 from one container, so
# build a verification keyring containing the current keys published by each
# configured upstream rather than installing only the Debian 13 cuda-keyring.
RUN set -eux; \
  tmp="$(mktemp -d)"; \
  curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/3bf863cc.pub -o "$tmp/debian12.pub"; \
  curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/8793F200.pub -o "$tmp/debian13.pub"; \
  curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub -o "$tmp/ubuntu2404.pub"; \
  curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2604/x86_64/60DF8A40.pub -o "$tmp/ubuntu2604.pub"; \
  gpg --batch --yes --dearmor -o "$tmp/debian12.gpg" "$tmp/debian12.pub"; \
  gpg --batch --yes --dearmor -o "$tmp/debian13.gpg" "$tmp/debian13.pub"; \
  gpg --batch --yes --dearmor -o "$tmp/ubuntu2404.gpg" "$tmp/ubuntu2404.pub"; \
  gpg --batch --yes --dearmor -o "$tmp/ubuntu2604.gpg" "$tmp/ubuntu2604.pub"; \
  cat "$tmp/debian12.gpg" "$tmp/debian13.gpg" "$tmp/ubuntu2404.gpg" "$tmp/ubuntu2604.gpg" \
    > /usr/share/keyrings/cuda-archive-keyring.gpg; \
  gpg --batch --show-keys /usr/share/keyrings/cuda-archive-keyring.gpg >/dev/null; \
  rm -rf "$tmp"; \
  test -s /usr/share/keyrings/cuda-archive-keyring.gpg

WORKDIR /work
