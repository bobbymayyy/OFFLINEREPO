#!/usr/bin/env python3
"""Selective OFFLINEREPO batch sync wrapper.

Creates a temporary config with only requested top-level repository profiles enabled,
then delegates to offline-repoctl. Successful syncs write a portable state manifest
and install the disconnected-side merge helper into repo_root.
"""

from __future__ import annotations

import argparse
import copy
import datetime as dt
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile
from typing import Any

import yaml

HERE = pathlib.Path(__file__).resolve().parent
FAMILIES = ("apt", "rpm", "apk")
STATE_FILE = ".offlinerepo-state.json"


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def load_config(path: pathlib.Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle) or {}


def profile_index(cfg: dict[str, Any]) -> dict[str, list[tuple[str, dict[str, Any]]]]:
    index: dict[str, list[tuple[str, dict[str, Any]]]] = {}
    for family in FAMILIES:
        for entry in cfg.get(family, []) or []:
            name = str(entry.get("name", "")).strip()
            if name:
                index.setdefault(name.lower(), []).append((family, entry))
                index.setdefault(f"{family}:{name}".lower(), []).append((family, entry))
    return index


def resolve_selectors(cfg: dict[str, Any], selectors: list[str]) -> list[tuple[str, str]]:
    index = profile_index(cfg)
    resolved: list[tuple[str, str]] = []
    seen: set[tuple[str, str]] = set()
    errors: list[str] = []

    for selector in selectors:
        matches = index.get(selector.lower(), [])
        if not matches:
            errors.append(f"unknown profile '{selector}'")
            continue
        unique = {(family, str(entry.get('name', '')).strip()) for family, entry in matches}
        if len(unique) > 1 and ":" not in selector:
            choices = ", ".join(sorted(f"{family}:{name}" for family, name in unique))
            errors.append(f"ambiguous profile '{selector}'; use one of: {choices}")
            continue
        family, entry = matches[0]
        name = str(entry.get("name", "")).strip()
        if not entry.get("enabled", False):
            errors.append(f"profile '{family}:{name}' is disabled in config.yml")
            continue
        key = (family, name)
        if key not in seen:
            seen.add(key)
            resolved.append(key)

    if errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(2)
    return resolved


def filtered_config(cfg: dict[str, Any], selected: list[tuple[str, str]]) -> dict[str, Any]:
    out = copy.deepcopy(cfg)
    selected_keys = {(family, name) for family, name in selected}
    for family in FAMILIES:
        for entry in out.get(family, []) or []:
            name = str(entry.get("name", "")).strip()
            entry["enabled"] = (family, name) in selected_keys

    # Batch mode must never mirror-delete a cumulative disconnected repository.
    # Accumulation is handled explicitly by merge-offlinerepo.py.
    paths = out.setdefault("paths", {})
    paths["permanent_root"] = ""
    return out


def list_profiles(cfg: dict[str, Any]) -> int:
    for family in FAMILIES:
        for entry in cfg.get(family, []) or []:
            name = str(entry.get("name", "")).strip() or "<unnamed>"
            status = "enabled" if entry.get("enabled", False) else "disabled"
            print(f"{family}:{name}\t{status}")
    return 0


def load_state(path: pathlib.Path) -> dict[str, Any]:
    if not path.is_file():
        return {"format": 1, "profiles": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("state root is not an object")
        data.setdefault("format", 1)
        data.setdefault("profiles", {})
        return data
    except Exception as exc:
        backup = path.with_name(path.name + ".invalid")
        try:
            shutil.copy2(path, backup)
        except OSError:
            pass
        print(f"WARN: could not parse existing state manifest ({exc}); starting a new manifest", file=sys.stderr)
        return {"format": 1, "profiles": {}}


def write_state(repo_root: pathlib.Path, selected: list[tuple[str, str]]) -> None:
    state_path = repo_root / STATE_FILE
    state = load_state(state_path)
    profiles = state.setdefault("profiles", {})
    now = utc_now()
    batch = []
    for family, name in selected:
        key = f"{family}:{name}"
        profiles[key] = {"family": family, "name": name, "last_synced_at": now}
        batch.append(key)
    state.update({
        "format": 1,
        "updated_at": now,
        "last_batch": batch,
        "profiles": dict(sorted(profiles.items())),
    })
    tmp = state_path.with_name(state_path.name + ".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, state_path)


def install_portable_helpers(repo_root: pathlib.Path) -> None:
    for name in ("serve-offlinerepo.py", "merge-offlinerepo.py"):
        src = HERE / name
        if not src.is_file():
            raise FileNotFoundError(f"portable helper missing from checkout: {src}")
        dst = repo_root / name
        shutil.copy2(src, dst)
        try:
            dst.chmod(0o755)
        except OSError:
            pass


def run_controller(config_path: pathlib.Path, action: str) -> int:
    controller = HERE / "offline-repoctl"
    if not controller.is_file():
        print(f"ERROR: controller missing: {controller}", file=sys.stderr)
        return 2
    env = os.environ.copy()
    env["CFG"] = str(config_path)
    return subprocess.run([str(controller), action], env=env, check=False).returncode


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Preflight or sync only selected OFFLINEREPO profiles without changing config.yml."
    )
    parser.add_argument("action", choices=("list", "preflight", "sync"))
    parser.add_argument("profiles", nargs="*", help="profile names, e.g. debian kali, or family:name")
    parser.add_argument("--config", default=os.environ.get("CFG", str(HERE / "config.yml")))
    args = parser.parse_args()

    cfg_path = pathlib.Path(args.config).expanduser().resolve()
    cfg = load_config(cfg_path)
    if args.action == "list":
        return list_profiles(cfg)
    if not args.profiles:
        parser.error("batch preflight/sync requires at least one profile")

    selected = resolve_selectors(cfg, args.profiles)
    selected_text = ", ".join(f"{family}:{name}" for family, name in selected)
    print(f"Batch selection: {selected_text}")
    if str((cfg.get("paths", {}) or {}).get("permanent_root", "")).strip():
        print("Batch safety: paths.permanent_root is disabled for this run; use merge-offlinerepo.py to accumulate states.")

    batch_cfg = filtered_config(cfg, selected)
    temp_path: pathlib.Path | None = None
    try:
        # Keep the temporary file beside config.yml so Docker/Podman bind-mount behavior
        # matches the user's existing checkout, including SELinux-labelled directories.
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            prefix=".offlinerepo-batch-",
            suffix=".yml",
            dir=str(cfg_path.parent),
            delete=False,
        ) as handle:
            yaml.safe_dump(batch_cfg, handle, sort_keys=False)
            temp_path = pathlib.Path(handle.name)

        rc = run_controller(temp_path, args.action)
        if rc != 0:
            return rc

        if args.action == "sync":
            repo_root_text = str((batch_cfg.get("paths", {}) or {}).get("repo_root", "")).strip()
            if not repo_root_text:
                print("ERROR: paths.repo_root is empty", file=sys.stderr)
                return 2
            repo_root = pathlib.Path(os.path.abspath(os.path.expanduser(repo_root_text)))
            repo_root.mkdir(parents=True, exist_ok=True)
            install_portable_helpers(repo_root)
            write_state(repo_root, selected)
            print(f"Portable batch state recorded in {repo_root / STATE_FILE}")
            print(f"Disconnected merge: python3 {repo_root / 'merge-offlinerepo.py'} /srv/OFFLINEREPO")
        return 0
    finally:
        if temp_path is not None:
            temp_path.unlink(missing_ok=True)


if __name__ == "__main__":
    raise SystemExit(main())
